{
  "name": "pureico",
  "version": "1.0.0",
  "private": true,
  "description": "Private, in-browser ICO and ICNS icon maker. Your files never leave your device.",
  "homepage": "https://pureico.intercepth.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/intercepth/Pureico.git"
  },
  "license": "MIT",
  "author": "Intercepth",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
