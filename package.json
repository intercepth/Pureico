    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
